<!--
  agree 独立 AAR 的 manifest。

  与原生 WebView 的关键差异：原生 WebView 由系统 framework 安装为系统组件，
  本文件描述的是要打进 AAR、由宿主 App 合并的 manifest。

  离线参考模板：android_webview/nonembedded/java/AndroidManifest.xml（jinja）。

  注意以下几点，改动前请先读：
  1. SandboxedProcessService 必须 exported=true 且带 externalService="true"。
     系统通过 bindServiceAsUser 绑定沙箱进程来拉起 renderer，
     exported=false 会让绑定失败，表现为页面白屏 / 渲染进程起不来。
  2. NUM_SANDBOXED_SERVICES 必须与下面声明的 service 数量一致。
     原生 WebView 用 40，这里保持一致，否则多 WebView 实例场景下
     分不到 renderer 进程。
  3. 不要声明 RECORD_VIDEO —— 该权限在 Android 中从未存在，只会触发 lint 报错。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="agree.webkit">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- WebRTC / 网页录音 -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- 渲染保活 -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application android:hardwareAccelerated="true">

    <!-- 沙箱渲染进程数量，必须与下方声明的 SandboxedProcessService 条数一致 -->
    <meta-data android:name="org.chromium.content.browser.NUM_SANDBOXED_SERVICES"
               android:value="40"/>

    <service android:name="org.chromium.content.app.SandboxedProcessService0"
             android:process=":sandboxed_process0"
             android:isolatedProcess="true"
             android:exported="true"
             android:externalService="true"
             android:visibleToInstantApps="true" />
