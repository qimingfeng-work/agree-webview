# agree 交付开关。
declare_args() {
  # 是否把 32 位（armeabi-v7a）的 libwebviewchromium.so 一并打进 AAR。
  #
  # 默认 true：Android 7 存量设备中 32 位 / 32 位优先机型占比不低，
  # AAR 需要双 ABI 才能覆盖。
  #
  # 前置条件：构建时 target_cpu = "arm64"，GN 才会生成 secondary ABI
  # toolchain（build/config/android/abi.gni:95-107 中
  # android_secondary_abi_cpu = "arm"）。若该 toolchain 未产出 32 位
  # libwebviewchromium.so，把本开关置 false 退回单 ABI。
  #
  # 用法（args.gn）：
  #   enable_agree_arm = false     # 只出 arm64-v8a
  enable_agree_arm = true
}

copy("copy_snapshot_blob") {
  sources = [ "$root_build_dir/snapshot_blob.bin" ]
  outputs = [ "$target_gen_dir/snapshot_blob_64.bin" ]

  deps = [
    "//v8",
    "//gin:v8_snapshot_assets",
  ]
}

android_resources("webkit_glue_resources") {
  sources = [
    "java/res_webkit/layout/js_prompt.xml",
    "java/res_webkit/layout/webview_find.xml",
    "java/res_webkit/menu/webview_find.xml",
  ]

  deps = [ ]
  custom_package = "agree.webkit"
}

generate_jni("draw_fn_impl_jni_headers") {
  sources = [
    "java/src/agree/webkit/MyDrawFunctor.java"
  ]
}

android_library("draw_fn_impl_java") {
  sources = [
    "java/src/agree/webkit/MyDrawFunctor.java"
  ]
  srcjar_deps = [ ":draw_fn_impl_jni_headers" ]
  # M119 的 @JNINamespace/@NativeMethods 在 //base:jni_java（独立 target，
  # 不在 base_java 里）；生成的 MyDrawFunctorJni.java 引用
  # org.chromium.build.annotations.CheckDiscard（//build/android:build_java）
  # 与 org.jni_zero.JniStaticTestMocker（//third_party/jni_zero:test_mocker_java，
  # M119 的 jni_zero 只有 test_mocker_java / native_library_loaded_status_java，
  # 没有 M126+ 的 jni_zero_java）。
  deps = [
    "//base:base_java",
    "//base:jni_java",
    "//build/android:build_java",
    "//third_party/jni_zero:test_mocker_java",
  ]
}

