+          #   [ { lib = "path/to/lib.so", abi = "arm64-v8a" }, ... ]
+          # Each library gets its own jni/<abi>/ directory in the AAR.
+          # (GN 2121 foreach does not iterate scopes; BUILD.gn passes a
+          # scope list and the loop accesses the .lib / .abi members.)
+          _abi_mapping = invoker.abi_mapping
