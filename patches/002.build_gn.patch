 # The shared library used by standalone WebView.
+# ==============================================================================
+# agree 定制：draw fn（GL / Vulkan functor）的 native 实现。
+#
+# 背景：
+#   MyDrawFunctor.java 通过 @JNINamespace("draw_fn") 声明了 7 个 native 方法
+#   （getDrawFnFunctionTable / init / setSurface / resizeSurface /
+#   setOverlaysSurface / sync / draw）。M119 的 libwebviewchromium 不含任何
+#   draw_fn 实现，若不把这些 .cc 链进去，WebView 初始化阶段调用
+#   MyDrawFunctor.getDrawFnFunctionTable() 就会抛 UnsatisfiedLinkError。
+#
+# 目录布局：
+#   agree 仓库需要整体拷贝到 src/android_webview/agree/，
+#   因为 draw_functor.cc 里的 include 写死了
+#   "android_webview/agree/java/src/draw_fn/xxx.h"。
+#
+# JNI 头：
+#   draw_functor.cc 引用
+#   "android_webview/agree/draw_fn_impl_jni_headers/MyDrawFunctor_jni.h"，
+#   该头文件由 ../agree/BUILD.gn 里的 generate_jni("draw_fn_impl_jni_headers")
+#   生成（target_gen_dir 落在 android_webview/agree/ 下），
+#   所以这里必须依赖它。
+# ==============================================================================
+source_set("agree_draw_fn_native") {
+  sources = [
+    "agree/java/src/draw_fn/allocator.cc",
+    "agree/java/src/draw_fn/allocator.h",
+    "agree/java/src/draw_fn/draw_functor.cc",
+    "agree/java/src/draw_fn/draw_functor.h",
+    "agree/java/src/draw_fn/overlays_manager.cc",
+    "agree/java/src/draw_fn/overlays_manager.h",
+  ]
+
+  deps = [
+    # MyDrawFunctor_jni.h 的来源
+    "//android_webview/agree:draw_fn_impl_jni_headers",
+    "//android_webview/public",  # android_webview/public/browser/draw_fn.h
+    "//base",
+    "//gpu/vulkan",
+    "//gpu/vulkan/init",
+    "//gpu/vulkan/init:skia",
+    "//skia",
+    "//ui/gl",
+  ]
+}
+
 template("libwebviewchromium_tmpl") {
   shared_library_with_jni(target_name) {
     forward_variables_from(invoker, "*")
     deps = [
+      # agree 定制：draw fn 的 native 实现（GL/Vulkan functor）。
+      # MyDrawFunctor.java 声明的 7 个 native 方法由这里提供，
+      # 缺了会在 WebView 初始化时抛 UnsatisfiedLinkError。
+      ":agree_draw_fn_native",
       "//android_webview/lib",
       "//android_webview/lib:webview_entry_point",
       "//android_webview/nonembedded",
@@ -996,9 +1045,38 @@ android_resources("resources") {
     "java/res/drawable-xxxhdpi/ic_play_circle_outline_black_48dp.png",
     "java/res/raw/histograms_allowlist.txt",
   ]
+
   deps = [ ":strings_grd" ]
 }
 
+# ==============================================================================
+# agree 定制：WebView glue 层资源
+#
+# 原生 WebView 作为系统组件时，js_prompt / webview_find 这些资源由系统
+# framework-res 提供，Chromium 只需引用资源 id。agree 是独立 AAR，
+# 宿主 App 里没有这些 id，必须自己打包一份并生成自己的 R 类，
+# 否则 JsDialogHelper / FindActionModeCallback 运行时抛 Resources$NotFoundException。
+#
+# 这三个 xml 定义的 id 与 agree Java 代码一一对应：
+#   layout/js_prompt.xml      -> R.id.message, R.id.value   (JsDialogHelper)
+#   layout/webview_find.xml   -> R.id.edit, R.id.matches    (FindActionModeCallback)
+#   menu/webview_find.xml     -> R.id.find_prev, R.id.find_next (FindActionModeCallback)
+#
+# custom_package 必须与 agree 源码包名一致：JsDialogHelper 等位于
+# agree.webkit，且未显式 import R，依赖同包解析。
+# ==============================================================================
+android_resources("webkit_glue_resources") {
+  sources = [
+    "java/res_webkit/layout/js_prompt.xml",
+    "java/res_webkit/layout/webview_find.xml",
+    "java/res_webkit/menu/webview_find.xml",
+  ]
+
+  deps = []
+
+  custom_package = "agree.webkit"
+}
+
 grit("generate_webui_resources") {
   enable_input_discovery_for_gn_analyze = false
   defines =
